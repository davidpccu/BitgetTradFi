# This service is permanently dry-run in Phase 1. DRY_RUN=false is rejected.
DRY_RUN=true
PORT=3000
HOST=0.0.0.0

SPOT_SYMBOL=RSTRCUSDT
FUTURES_SYMBOL=STRCUSDT
HEDGE_RATIO=1.0
HEDGE_CLIENT_OID_PREFIX=HEDGE_
FUTURES_QTY_STEP=0.0001
MARKET_STALE_MS=15000
MAX_HEDGE_DELAY_MS=3000
MAX_UNHEDGED_NOTIONAL_USDT=100

# Verify these UTA endpoints/subscription arguments against current Bitget docs.
BITGET_PUBLIC_WS_URL=wss://ws.bitget.com/v3/ws/public
BITGET_PRIVATE_WS_URL=wss://ws.bitget.com/v3/ws/private
# JSON arrays may be overridden if the current official contract differs.
# BITGET_PUBLIC_SUBSCRIPTIONS=[{"instType":"SPOT","channel":"ticker","instId":"RSTRCUSDT"},{"instType":"USDT-FUTURES","channel":"ticker","instId":"STRCUSDT"}]
# BITGET_PRIVATE_SUBSCRIPTIONS=[{"instType":"UTA","channel":"orders","instId":"default"}]

# Private credentials are server-side only. Without them, UI starts in RECOVERY.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Optional Telegram alerts. Without both values, alerts are written to stdout.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional local Phase 1 snapshot. Koyeb local filesystem is not durable.
STATE_FILE=
